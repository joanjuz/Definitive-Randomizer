<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reuses the repository's friend access in a separate, research-only output directory. -->
    <AssemblyName>3DS.Progressive.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <ProjectReference Include="../../../../3DS.Progressive.App/3DS.Progressive.App.csproj" />
    <Compile Include="../../../../3DS.Progressive.Tests/WpfTestHost.cs" Link="WpfTestHost.cs" />
  </ItemGroup>
</Project>
