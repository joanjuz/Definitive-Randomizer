<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Isolated research assembly; reuse existing friend access, never production admission. -->
    <AssemblyName>3DS.Progressive.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../observed_profiles.json" LogicalName="ObservedProfiles" />
    <Using Remove="System.Windows.Forms" />
    <ProjectReference Include="../../../../3DS.Progressive.App/3DS.Progressive.App.csproj" />
  </ItemGroup>
</Project>
