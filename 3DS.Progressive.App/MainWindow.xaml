<Window x:Class="ThreeDS.Progressive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Definitive Randomizer — Editor" Width="1390" Height="845"
        MinWidth="1130" MinHeight="690" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SmallHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="NavDisabled" BasedOn="{StaticResource SidebarButton}" TargetType="Button">
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="73"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="69"/>
        </Grid.RowDefinitions>

        <!-- Cabecera permanente -->
        <Border Grid.Row="0" Background="#111720" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="39" Height="39" CornerRadius="10" Background="#2D4665"
                            Margin="0,0,12,0">
                        <TextBlock Text="DR" FontSize="17" FontWeight="Bold" Foreground="#9FC7F5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Definitive Randomizer" FontWeight="SemiBold" FontSize="17"/>
                        <TextBlock Text="EDICIÓN DE JUEGOS 3DS" Foreground="{StaticResource TextSoft}"
                                   FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="45,0,12,0">
                    <TextBlock x:Name="ProjectNameText" Text="Sin proyecto cargado"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GameNameText" Text="Seleccioná una carpeta de juego extraído"
                               FontSize="12" Foreground="{StaticResource TextSoft}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackupButton" Content="Generar backup" Click="Backup_Click" IsEnabled="False" Margin="0,0,10,0"/>
                    <Button x:Name="ExtractRomButton" Click="ExtractRom_Click" Content="Extraer ROM..." Margin="0,0,8,0"/>
                    <Button x:Name="RestoreBackupButton" Click="RestoreBackup_Click" Content="Restaurar backup…" Margin="0,0,8,0"/>
                    <Button x:Name="OpenProjectButton" Click="OpenProject_Click" Style="{StaticResource PrimaryButton}" Content="Abrir proyecto..."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="211"/>
                <ColumnDefinition Width="239"/>
                <ColumnDefinition Width="*" MinWidth="410"/>
                <ColumnDefinition Width="252"/>
            </Grid.ColumnDefinitions>

            <!-- Navegacion -->
            <Border Background="#18202B" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="13,18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="EDICIÓN" Style="{StaticResource SmallHeading}"
                                   Margin="12,0,0,12"/>
                        <Button x:Name="PokemonNavButton" Click="Pokemon_Click" Content="◆  Pokémon" Style="{StaticResource SidebarButton}"
                                Background="#2B4059" FontWeight="SemiBold"/>
                        <Button x:Name="TrainersButton" Content="⚔  Entrenadores" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Trainers" Click="Section_Click"/>
                        <Button x:Name="EncountersButton" Content="◎  Encuentros" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Encounters" Click="Section_Click"/>
                        <Button x:Name="StaticEncountersButton" Content="◉  Encuentros estáticos"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="StaticEncounters" Click="Section_Click"/>
                        <Button x:Name="MovesButton" Content="◇  Movimientos" Style="{StaticResource SidebarButton}" IsEnabled="False" Click="Moves_Click"/>
                        <Button x:Name="LevelUpButton" Content="↗  Level Up Moves"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="LevelUp" Click="Section_Click"/>
                        <Button x:Name="MachineTutorButton" Content="▣  MT y tutores" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="MachineTutor" Click="Section_Click"/>
                        <Button x:Name="ItemsButton" Content="▤  Objetos y economía" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Items" Click="Section_Click"/>
                        <Button x:Name="MartsButton" Content="▦  Tiendas y BP · USUM" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Marts" Click="Section_Click"/>
                        <Button x:Name="FieldItemsButton" Content="♢  Field Items"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="FieldItems" Click="Section_Click"/>
                        <Button x:Name="EvolutionsButton" Content="◆  Evoluciones" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Evolutions" Click="Section_Click"/>
                        <Button x:Name="GameTextButton" Content="≡  Game Text" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="GameText" Click="Section_Click"/>
                        <Button x:Name="StoryTextButton" Content="≡  Story Text · diálogos" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="StoryText" Click="Section_Click"/>
                        <TextBlock Text="SISTEMAS" Style="{StaticResource SmallHeading}"
                                   Margin="12,25,0,12"/>
                        <Button x:Name="MechanicsButton" Content="◈  Mecánicas y CRO"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Mechanics" Click="Section_Click"/>
                        <Button x:Name="PokemonToolsButton" Content="◈  Herramientas Pokémon"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="PokemonTools" Click="Section_Click"/>
                        <Button x:Name="RomToolsButton" Content="▧  Herramientas ROM"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="RomTools" Click="Section_Click"/>
                        <Button x:Name="AutomationButton" Content="⇄  Automatización"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Automation" Click="Section_Click"/>
                        <Button x:Name="ConfigurationButton" Content="⚙  Opciones e idioma"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="Configuration" Click="Section_Click"/>
                        <Button x:Name="GlobalTemplateButton" Content="▣  Global Template"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="GlobalTemplate" Click="Section_Click"/>
                        <Button x:Name="BatchRomButton" Content="▣  Batch ROM Builder"
                                Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="BatchRom" Click="Section_Click"/>
                        <Button x:Name="HistoryButton" Content="≡  Historial de cambios" Style="{StaticResource SidebarButton}" IsEnabled="False" Tag="History" Click="Section_Click"/>
                    </StackPanel>
                    </ScrollViewer>
                    <Border Visibility="Collapsed" DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                            CornerRadius="9" Padding="12" VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock Text="HITO 01" Foreground="{StaticResource Accent}"
                                       FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Editor de datos personales" TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Los demás módulos están pendientes, no simulados."
                                       Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Lista y busqueda -->
            <Border x:Name="PokemonListPanel" Grid.Column="1" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="0,0,1,0" Background="#1B2430">
                <DockPanel Margin="14,19">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                        <TextBlock Text="ESPECIES Y FORMAS" Style="{StaticResource SmallHeading}"
                                   Margin="0,0,0,13"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Buscar por nombre o número de entrada"/>
                        <TextBlock x:Name="EntryCountText" Text="Sin datos" FontSize="11"
                                   Foreground="{StaticResource TextSoft}" Margin="2,10,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="PokemonList" SelectionChanged="PokemonList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor central -->
            <ScrollViewer x:Name="PokemonEditorPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource Bg}" Padding="0">
                <StackPanel x:Name="EditorContent" Margin="25,23" IsEnabled="False"
                            Background="{StaticResource Bg}">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Datos de Pokémon" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EntryTitleText" Text="Abrí un proyecto para comenzar."
                                   Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Cabecera: sprite + identidad + tipos + estado -->
                    <Border Style="{StaticResource Card}" Background="#222F3D">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#172331" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" CornerRadius="12" Width="104" Height="112"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid>
                                    <Grid x:Name="SpriteFallback" Opacity="0.55">
                                        <Ellipse Stroke="#7790AB" StrokeThickness="4" Width="58" Height="58"/>
                                        <Rectangle Fill="#7790AB" Height="4" Width="58"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse Fill="#172331" Stroke="#7790AB" StrokeThickness="3"
                                                 Width="18" Height="18"/>
                                    </Grid>
                                    <Image x:Name="PokemonSprite" Width="96" Height="96"
                                           Stretch="Uniform" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock x:Name="HeaderNameText" Text="Sin Pokémon"
                                           FontSize="22" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HeaderNumberText" Text="Seleccioná una especie"
                                           FontSize="12" Foreground="{StaticResource TextSoft}"
                                           Margin="0,4,0,13"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Border x:Name="TypeBadgeOne" CornerRadius="7"
                                            Background="#395469" Padding="11,6"
                                            Margin="0,0,7,6">
                                        <TextBlock x:Name="TypeBadgeOneText" Text="—"
                                                   FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                    </Border>
                                    <Border x:Name="TypeBadgeTwo" CornerRadius="7"
                                            Background="#395469" Padding="11,6"
                                            Margin="0,0,7,6">
                                        <TextBlock x:Name="TypeBadgeTwoText" Text="—"
                                                   FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                    </Border>
                                </WrapPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="BST  " Foreground="{StaticResource TextSoft}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="HeaderBstText" Text="—" FontSize="16"
                                               FontWeight="Bold" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Border x:Name="DirtyBadge" Background="#35485D"
                                            CornerRadius="7" Padding="9,5">
                                        <TextBlock x:Name="DirtyBadgeText" Text="Sin cambios"
                                                   Foreground="#C5D7E9" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ESTADÍSTICAS BASE" Style="{StaticResource SmallHeading}"
                                       Margin="0,0,0,13"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,13">
                                    <TextBlock Text="PS" Style="{StaticResource FieldCaption}"/>
                                    <TextBox x:Name="HpBox" TextChanged="Stat_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,13">
                                    <TextBlock Text="Ataque" Style="{StaticResource FieldCaption}"/>
                                    <TextBox x:Name="AtkBox" TextChanged="Stat_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,13">
                                    <TextBlock Text="Defensa" Style="{StaticResource FieldCaption}"/>
                                    <TextBox x:Name="DefBox" TextChanged="Stat_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,13">
                                    <TextBlock Text="Ataque Especial" Style="{StaticResource FieldCaption}"/>
                                    <TextBox x:Name="SpaBox" TextChanged="Stat_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Defensa Especial" Style="{StaticResource FieldCaption}"/>
                                    <TextBox x:Name="SpdBox" TextChanged="Stat_TextChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Velocidad" Style="{StaticResource FieldCaption}"/>
                                    <TextBox x:Name="SpeBox" TextChanged="Stat_TextChanged"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="TIPOS Y CAPTURA" Style="{StaticResource SmallHeading}"
                                       Margin="0,0,0,13"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Text="Primer tipo" Style="{StaticResource FieldCaption}"/>
                                    <ComboBox x:Name="TypeOne" SelectionChanged="Type_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Segundo tipo" Style="{StaticResource FieldCaption}"/>
                                    <ComboBox x:Name="TypeTwo" SelectionChanged="Type_SelectionChanged"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Ratio de captura (0–255)"
                                       Style="{StaticResource FieldCaption}"/>
                            <TextBox x:Name="CatchBox" TextChanged="Stat_TextChanged"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
    <Expander Header="HABILIDADES Y OBJETOS" IsExpanded="False" Foreground="{StaticResource TextMain}"
              Background="{StaticResource Panel}" Padding="0">
        <StackPanel Margin="0,13,0,0">
            <TextBlock Text="Compatibilidad Gen 6/7. Seleccioná habilidades y los tres objetos posibles." FontSize="11" Foreground="{StaticResource TextSoft}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Habilidad 1" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="AbilityOne" SelectionChanged="Type_SelectionChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Habilidad 2" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="AbilityTwo" SelectionChanged="Type_SelectionChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Habilidad oculta" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="AbilityHidden" SelectionChanged="Type_SelectionChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Objeto equipable 1" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="HeldItemOne" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" MaxDropDownHeight="300"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Objeto equipable 2" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="HeldItemTwo" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" MaxDropDownHeight="300"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Objeto equipable 3" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="HeldItemThree" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" MaxDropDownHeight="300"/></StackPanel>
            </UniformGrid>
        </StackPanel>
    </Expander>
</Border>
                    <Border Style="{StaticResource Card}">
    <Expander Header="EV OTORGADOS" IsExpanded="False" Foreground="{StaticResource TextMain}"
              Background="{StaticResource Panel}" Padding="0">
        <StackPanel Margin="0,13,0,0">
            <TextBlock Text="Cada stat otorga entre 0 y 3 EV al derrotar al Pokémon." FontSize="11" Foreground="{StaticResource TextSoft}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,10,13"><TextBlock Text="EV PS" Style="{StaticResource FieldCaption}"/><TextBox x:Name="EvHpBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="EV Ataque" Style="{StaticResource FieldCaption}"/><TextBox x:Name="EvAtkBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="EV Defensa" Style="{StaticResource FieldCaption}"/><TextBox x:Name="EvDefBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="EV Ataque Esp." Style="{StaticResource FieldCaption}"/><TextBox x:Name="EvSpaBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="EV Defensa Esp." Style="{StaticResource FieldCaption}"/><TextBox x:Name="EvSpdBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="EV Velocidad" Style="{StaticResource FieldCaption}"/><TextBox x:Name="EvSpeBox" TextChanged="Stat_TextChanged"/></StackPanel>
            </UniformGrid>
        </StackPanel>
    </Expander>
</Border>
                    <Border Style="{StaticResource Card}">
    <Expander Header="CRIANZA Y CARACTERÍSTICAS" IsExpanded="False" Foreground="{StaticResource TextMain}"
              Background="{StaticResource Panel}" Padding="0">
        <StackPanel Margin="0,13,0,0">
            <TextBlock Text="Valores internos originales de pk3DS; se conservan los campos que todavía no se editan." FontSize="11" Foreground="{StaticResource TextSoft}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Experiencia base (0–65535)" Style="{StaticResource FieldCaption}"/><TextBox x:Name="BaseExpBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Amistad (0–255)" Style="{StaticResource FieldCaption}"/><TextBox x:Name="FriendshipBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Ciclos de eclosión" Style="{StaticResource FieldCaption}"/><TextBox x:Name="HatchBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Ratio de género (0–255)" Style="{StaticResource FieldCaption}"/><TextBox x:Name="GenderBox" TextChanged="Stat_TextChanged"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Grupo huevo 1" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="EggOneBox" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" MaxDropDownHeight="300"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Grupo huevo 2" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="EggTwoBox" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" MaxDropDownHeight="300"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Curva de experiencia" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="GrowthBox" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" MaxDropDownHeight="300"/></StackPanel>
              <StackPanel Margin="0,0,10,13"><TextBlock Text="Ratio de escape (0–255)" Style="{StaticResource FieldCaption}"/><TextBox x:Name="EscapeBox" TextChanged="Stat_TextChanged"/></StackPanel>
            </UniformGrid>
        </StackPanel>
    </Expander>
</Border>
                    <Border Style="{StaticResource Card}">
                        <Expander Header="FORMAS, COLOR Y DATOS FÍSICOS" Foreground="{StaticResource TextMain}" IsExpanded="False">
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Los valores de altura y peso se muestran en unidades internas del juego; la asignación de Form Stats Index se mantiene sin edición para prevenir daños."
                                           Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Etapa de evolución (0–255)" Style="{StaticResource FieldCaption}"/>
 <TextBox x:Name="EvoStageBox" TextChanged="Stat_TextChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Número de formas (0–255)" Style="{StaticResource FieldCaption}"/>
 <TextBox x:Name="FormCountBox" TextChanged="Stat_TextChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Sprite de forma (0–65535)" Style="{StaticResource FieldCaption}"/>
 <TextBox x:Name="FormSpriteBox" TextChanged="Stat_TextChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Color interno (0–63)" Style="{StaticResource FieldCaption}"/>
 <TextBox x:Name="ColorBox" TextChanged="Stat_TextChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Altura (centésimas de metro)" Style="{StaticResource FieldCaption}"/>
 <TextBox x:Name="HeightBox" TextChanged="Stat_TextChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Peso (décimas de kg)" Style="{StaticResource FieldCaption}"/>
 <TextBox x:Name="WeightBox" TextChanged="Stat_TextChanged" />
 </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border x:Name="Gen7PersonalCard" Style="{StaticResource Card}">
                        <Expander Header="POKÉMON ESPECIALES Y MOVIMIENTOS Z · GEN 7"
                                  Foreground="{StaticResource TextMain}" IsExpanded="False">
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Se reutilizan los nombres de objetos y movimientos extraídos del juego; el ID se conserva en el GARC."
                                           Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Cristal Z exclusivo" Style="{StaticResource FieldCaption}"/>
 <ComboBox x:Name="ZItemBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Movimiento base" Style="{StaticResource FieldCaption}"/>
 <ComboBox x:Name="ZBaseMoveBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" />
 </StackPanel>
                                    <StackPanel Margin="0,0,10,13">
 <TextBlock Text="Movimiento Z exclusivo" Style="{StaticResource FieldCaption}"/>
 <ComboBox x:Name="ZSpecialMoveBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Type_SelectionChanged" />
 </StackPanel>
                                    <CheckBox x:Name="RegionalVariantCheck" Content="Variante regional"
                                              Foreground="{StaticResource TextMain}" VerticalAlignment="Center"
                                              Checked="FlagCheck_Changed" Unchecked="FlagCheck_Changed"/>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Expander Header="COMPATIBILIDAD MT / TUTORES" Foreground="{StaticResource TextMain}" IsExpanded="False">
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Las MT incluyen sus 100 ranuras editables; los bits reservados se preservan. Los tutores especiales usan índices internos para no mostrar nombres incorrectos en ROMs custom."
                                           Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Marcar todas las MT" Click="CheckAllTm_Click" Margin="0,0,9,0"/>
                                    <Button Content="Quitar todas las MT" Click="UncheckAllTm_Click"/>
                                </WrapPanel>
                                <StackPanel Margin="0,0,10,10">
                                  <TextBlock Text="Máquinas técnicas (100 slots)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                  <ScrollViewer Height="230" VerticalScrollBarVisibility="Auto"
                                                Background="{StaticResource Surface}">
                                    <ItemsControl x:Name="TmFlagsList">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Content="{Binding Label}" ToolTip="{Binding Label}"
                                            Foreground="{StaticResource TextMain}"
                                            Padding="5" Width="270" Margin="3" FontSize="11"/>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </ScrollViewer>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                  <TextBlock Text="Tutores por tipo" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                  <ScrollViewer Height="230" VerticalScrollBarVisibility="Auto"
                                                Background="{StaticResource Surface}">
                                    <ItemsControl x:Name="TutorFlagsList">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Content="{Binding Label}" ToolTip="{Binding Label}"
                                            Foreground="{StaticResource TextMain}"
                                            Padding="5" Width="270" Margin="3" FontSize="11"/>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </ScrollViewer>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                  <TextBlock Text="Tutores especiales / Beach Tutors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                  <ScrollViewer Height="230" VerticalScrollBarVisibility="Auto"
                                                Background="{StaticResource Surface}">
                                    <ItemsControl x:Name="SpecialTutorFlagsList">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Content="{Binding Label}" ToolTip="{Binding Label}"
                                            Foreground="{StaticResource TextMain}"
                                            Padding="5" Width="270" Margin="3" FontSize="11"/>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Restablecer campos" Click="Reset_Click" Margin="0,0,10,0"/>
                        <Button x:Name="SaveButton" Content="Guardar en el proyecto"
                                Style="{StaticResource PrimaryButton}" Click="Save_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="PersonalToolsPanel" Grid.Column="2" Visibility="Collapsed">
                <ContentControl x:Name="PersonalToolsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>

            <!-- Inspector -->
            <Border x:Name="PokemonInspectorPanel" Grid.Column="3" Background="#1B2430"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                <StackPanel Margin="17,23">
                    <TextBlock Text="INSPECTOR" Style="{StaticResource SmallHeading}"
                               Margin="0,0,0,12"/>
                    <StackPanel x:Name="PersonalActions" IsEnabled="False" Margin="0,0,0,18">
                        <Button x:Name="RandomizePokemonButton" Content="Randomizar Pokémon" Click="PersonalAction_Click" Tag="PersonalRandomize" Margin="0,0,0,8"/>
                        <Button x:Name="ModifyPokemonButton" Content="Modificar Pokémon" Click="PersonalAction_Click" Tag="PersonalModify"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Total de estadísticas" Foreground="{StaticResource TextSoft}"/>
                            <TextBlock x:Name="BstText" Text="—" FontWeight="Bold" FontSize="36"
                                       Foreground="{StaticResource Accent}" Margin="0,6,0,0"/>
                            <TextBlock Text="BST (Base Stat Total)" FontSize="11"
                                       Foreground="{StaticResource TextSoft}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sesión actual" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock x:Name="SpriteStatusText" Text="Sin sprite"
                                       Foreground="{StaticResource TextSoft}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,9"/>
                            <TextBlock x:Name="InspectorGameText" Text="Sin juego"
                                       Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InspectorEntryText" Text="Sin especie"
                                       Foreground="{StaticResource TextSoft}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Seguridad de guardado" FontWeight="SemiBold"
                                       Margin="0,0,0,9"/>
                            <TextBlock Text="Solo se escribe al pulsar Guardar y confirmar. Se valida el GARC antes de reemplazar el archivo. Usa una copia de trabajo del juego."
                                       Foreground="{StaticResource TextSoft}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <ContentControl x:Name="SectionHost" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed"/>
            <ContentControl x:Name="MovesHost" Grid.Column="1" Grid.ColumnSpan="3"
                            Visibility="Collapsed" Background="{StaticResource Bg}"/>
        </Grid>

        <Border Grid.Row="2" Background="#111720" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0" LastChildFill="True">
                <TextBlock Text="DEFINITIVE RANDOMIZER · V0.8.0 PREVIEW"
                           DockPanel.Dock="Right" Foreground="{StaticResource TextSoft}"
                           FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="OperationPercent" DockPanel.Dock="Right"
                           Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Visibility="Collapsed" Text="0%"/>
                <ProgressBar x:Name="OperationProgress" DockPanel.Dock="Right"
                             Width="225" Height="12" Margin="12,0,10,0" IsIndeterminate="True"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Foreground="{StaticResource Accent}"
                             Background="{StaticResource Surface}" VerticalAlignment="Center"/>
                <TextBlock x:Name="OperationElapsedText" DockPanel.Dock="Right"
                           Foreground="{StaticResource TextSoft}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,10,0"
                           Visibility="Collapsed" Text="00:00"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Esperando proyecto extraído..."
                               Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OperationStageText" Text=""
                               Foreground="{StaticResource Accent}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
