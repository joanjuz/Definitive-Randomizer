<UserControl x:Class="ThreeDS.Progressive.MoveEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}">
    <UserControl.Resources>
        <Style x:Key="MoveCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="MoveLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="39"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111720" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Movimientos" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="3DS Progressive · Editor GARC" FontSize="12"
                               Foreground="{StaticResource TextSoft}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Editor integrado · 3DS Progressive"
                        VerticalAlignment="Center" IsEnabled="False" Padding="16,10"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="249"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="256"/>
            </Grid.ColumnDefinitions>
            <Border Background="#1B2430" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                <DockPanel Margin="15,20">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="LISTA DE MOVIMIENTOS" Foreground="{StaticResource TextSoft}"
                                   FontSize="11" FontWeight="SemiBold" Margin="1,0,0,12"/>
                        <TextBox x:Name="SearchInput" TextChanged="SearchInput_TextChanged"
                                 ToolTip="Buscar movimiento por nombre o número"/>
                        <TextBlock x:Name="CountText" FontSize="11" Foreground="{StaticResource TextSoft}"
                                   Margin="0,11,0,14"/>
                    </StackPanel>
                    <ListBox x:Name="MoveList" SelectionChanged="MoveList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Background="{StaticResource Bg}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="27,26">
                    <TextBlock x:Name="MoveNameText" Text="Seleccioná un movimiento"
                               FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MoveNumberText" Text="Campos básicos"
                               Margin="0,6,0,19" Foreground="{StaticResource TextSoft}"/>
                    <Border Style="{StaticResource MoveCard}">
                        <StackPanel>
                            <TextBlock Text="DATOS DEL MOVIMIENTO"
                                       Foreground="{StaticResource TextSoft}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,17">
                                    <TextBlock Text="Tipo" Style="{StaticResource MoveLabel}"/>
                                    <ComboBox x:Name="MoveType" SelectionChanged="Value_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,17">
                                    <TextBlock Text="Categoría" Style="{StaticResource MoveLabel}"/>
                                    <ComboBox x:Name="MoveCategory" SelectionChanged="Value_Changed">
                                        <ComboBoxItem Content="Estado"/>
                                        <ComboBoxItem Content="Físico"/>
                                        <ComboBoxItem Content="Especial"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,17">
                                    <TextBlock Text="Potencia (0–255)" Style="{StaticResource MoveLabel}"/>
                                    <TextBox x:Name="MovePower" TextChanged="Text_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,17">
                                    <TextBlock Text="Precisión (0–255)" Style="{StaticResource MoveLabel}"/>
                                    <TextBox x:Name="MoveAccuracy" TextChanged="Text_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="PP (0–255)" Style="{StaticResource MoveLabel}"/>
                                    <TextBox x:Name="MovePP" TextChanged="Text_Changed"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Prioridad (-8 a +8)" Style="{StaticResource MoveLabel}"/>
                                    <TextBox x:Name="MovePriority" TextChanged="Text_Changed"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MoveCard}">
                        <Expander Header="EFECTOS, GOLPES, OBJETIVOS Y FLAGS" Foreground="{StaticResource TextMain}" IsExpanded="False">
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="Las listas emplean las mismas categorías de pk3DS vanilla y conservan sus IDs internos."
                                           Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,13"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Calidad/animación (0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="QualityBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Golpes mínimos (0–15)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="MinHitsBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Golpes máximos (0–15)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="MaxHitsBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Efecto infligido (ID 0–65535)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="InflictBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Probabilidad de efecto (0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="InflictRateBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Etapa de crítico (0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="CritBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Probabilidad de retroceso (0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="FlinchBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Secuencia de efecto (0–65535)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="EffectBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Objetivo (ID 0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="TargetBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Flags (hexadecimal)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="FlagsBox" TextChanged="FlagsBox_TextChanged"/>
</StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border x:Name="ZMoveCard" Style="{StaticResource MoveCard}">
                        <Expander Header="OPCIONES DE MOVIMIENTOS Z · GEN 7" Foreground="{StaticResource TextMain}" IsExpanded="False">
                            <StackPanel Margin="0,16,0,0">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Movimiento Z asociado (ID)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="ZMoveBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Potencia Z (0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="ZPowerBox" TextChanged="Text_Changed"/>
</StackPanel>
                                    <StackPanel Margin="0,0,10,13">
    <TextBlock Text="Efecto Z (0–255)" Style="{StaticResource MoveLabel}"/>
    <TextBox x:Name="ZEffectBox" TextChanged="Text_Changed"/>
</StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Style="{StaticResource MoveCard}">
                        <TextBlock Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"
                                   Text="Este editor representa las opciones básicas y avanzadas de movimiento. La randomización masiva, balance, textos, CRO y parches Progressive serán módulos independientes."/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Restablecer" Click="Reset_Click" Margin="0,0,10,0"/>
                        <Button x:Name="SaveMoveButton" Content="Guardar movimiento"
                                Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="#1B2430" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
                <StackPanel Margin="17,24">
                    <TextBlock Text="INSPECTOR" Foreground="{StaticResource TextSoft}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource MoveCard}">
                        <StackPanel>
                            <TextBlock Text="Tipo y categoría" Foreground="{StaticResource TextSoft}"/>
                            <TextBlock x:Name="PreviewType" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            <TextBlock x:Name="PreviewCategory" Text="—" Foreground="{StaticResource Accent}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MoveCard}">
                        <StackPanel>
                            <TextBlock Text="Potencia" Foreground="{StaticResource TextSoft}"/>
                            <TextBlock x:Name="PreviewPower" Text="—" Foreground="{StaticResource Accent}"
                                       FontSize="34" FontWeight="Bold" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MoveCard}">
                        <StackPanel>
                            <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Border x:Name="ChangeStateBadge" CornerRadius="7" Background="#31544A" Padding="9,7">
                                <TextBlock x:Name="ChangeStateText" Text="Guardado" Foreground="#B6E8CC"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Trabajá sobre una copia del juego extraído. Los archivos solo se escriben al confirmar."
                                       FontSize="11" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"
                                       Margin="0,13,0,0" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#111720" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="StatusLabel" Text="Cargando tabla de movimientos..."
                           VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"
                           FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>