<UserControl x:Class="ThreeDS.Progressive.RecordEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource Bg}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#111720" Padding="22,14" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
   <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="239"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="252"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Padding="16,22">
    <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="LISTA Y BÚSQUEDA" Foreground="{StaticResource TextSoft}" FontSize="11"/>
     <TextBox x:Name="SearchText" TextChanged="Search_Changed" Margin="0,12,0,8"/><TextBlock x:Name="CountText" Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,0,0,14"/>
    </StackPanel><ListBox x:Name="RecordList" DisplayMemberPath="Display" SelectionChanged="Selection_Changed"/></DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="22,20">
    <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
     <StackPanel>
      <Border x:Name="TrainerTeamPreview" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16" Padding="14" Visibility="Collapsed">
       <StackPanel>
        <TextBlock Text="EQUIPO DEL ENTRENADOR" Foreground="{StaticResource TextSoft}" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text="Elegí un Pokémon para acceder a sus opciones." Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,4,0,8"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="TrainerTeamCards" Orientation="Horizontal"/></ScrollViewer>
       </StackPanel>
      </Border>
      <Border x:Name="EncounterSpritePreview" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10"
              Margin="0,0,0,16" Padding="14" Visibility="Collapsed">
       <StackPanel>
        <TextBlock x:Name="EncounterSpriteTitle" Text="SLOTS DEL ENCUENTRO"
                   Foreground="{StaticResource TextSoft}" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text="Seleccioná un sprite para editar el slot en su sección."
                   Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,4,0,10"/>
        <WrapPanel x:Name="EncounterSpriteCards"/>
       </StackPanel>
      </Border>
      <StackPanel x:Name="FieldsPanel"/>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="ToolsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent"><StackPanel>
      <TextBlock x:Name="ToolTitle" Text="Randomizar" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,15"/>
      <StackPanel x:Name="TemplatePanel" Visibility="Collapsed" Margin="0,0,0,15">
       <TextBlock Text="Template CSV de pk3DS Progressive" Foreground="{StaticResource TextSoft}" Margin="0,0,0,8"/>
       <TextBox x:Name="TemplatePathText" IsReadOnly="True" TextWrapping="Wrap"/>
       <WrapPanel Margin="0,10,0,0"><Button Content="Elegir CSV…" Click="ChooseTemplate_Click" Margin="0,0,8,8"/><Button Content="Usar Progressive" Click="DefaultTemplate_Click" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel><StackPanel x:Name="OptionsPanel"/>
      <TextBlock x:Name="ProposalText" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}" Margin="0,12"/>
      <ListBox x:Name="ChangeList" MaxHeight="600" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Field}" Foreground="{StaticResource TextSoft}"/><TextBlock Text="{Binding Before}" TextWrapping="Wrap"/><TextBlock Text="{Binding After}" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,0">
      <StackPanel><WrapPanel><Button x:Name="PreviewButton" Content="Generar vista previa" Click="Preview_Click" Margin="0,0,8,8"/><Button x:Name="ApplyButton" Content="Aplicar cambios" IsEnabled="False" Click="Apply_Click" Margin="0,0,0,8"/></WrapPanel>
       <Button Content="← Volver al editor" Click="Back_Click" HorizontalAlignment="Left"/></StackPanel>
     </Border>
    </Grid>
   </Grid>
   <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="18,22">
    <StackPanel><TextBlock Text="INSPECTOR" Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,0,0,12"/>
     <Button x:Name="RandomizerButton" Content="Randomizar" Click="Randomizer_Click" Margin="0,0,0,10"/>
     <Button x:Name="TrainerCapsButton" Content="Tabla de Level Caps" Visibility="Collapsed"
             Click="TrainerCaps_Click" Margin="0,0,0,8"/>
     <Button x:Name="TrainerMovesButton" Content="Tabla de Trainer Move Rules" Visibility="Collapsed"
             Click="TrainerMoves_Click" Margin="0,0,0,10"/>
     <Button x:Name="TemplateButton" Content="Template de evoluciones" Visibility="Collapsed" Click="Template_Click" Margin="0,0,0,10"/>
     <Button x:Name="ImportOptionsButton" Content="Cargar template de entrenadores" Visibility="Collapsed" Click="ImportOptions_Click" Margin="0,0,0,10"/>
     <Button x:Name="ExportOptionsButton" Content="Exportar template de entrenadores" Visibility="Collapsed" Click="ExportOptions_Click" Margin="0,0,0,10"/>
     <TextBlock x:Name="SelectionText" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Margin="0,13"/>
     <Button x:Name="SaveButton" Content="Guardar cambios" Click="Save_Click" IsEnabled="False" Margin="0,0,0,10"/>
     <Button Content="Descartar cambios" Click="Discard_Click" Margin="0,0,0,18"/>
     <TextBlock Text="Alcance de randomización" Foreground="{StaticResource TextSoft}" Margin="0,0,0,8"/>
     <ComboBox x:Name="ScopeBox" SelectedIndex="0" SelectionChanged="Scope_Changed"><ComboBoxItem Content="Todas las entradas"/><ComboBoxItem Content="Lista filtrada"/><ComboBoxItem Content="Entrada seleccionada"/></ComboBox>
     <TextBlock Text="El historial conserva los valores de una edición individual. Las operaciones masivas guardan la acción y sus opciones, con una semilla nueva para cada futura randomización." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,20,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#111720" Padding="20,12" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Editor listo." FontSize="11" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"/></Border>
 </Grid>
</UserControl>
