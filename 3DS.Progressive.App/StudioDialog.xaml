<Window x:Class="ThreeDS.Progressive.StudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="495" SizeToContent="Height" MinHeight="235" MaxHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#161E28" Foreground="#EFF3F8">
    <Border Background="#1B2531" CornerRadius="13" BorderBrush="#48607A" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="47"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#263447" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="19,0">
                    <TextBlock x:Name="TitleLabel" Text="Definitive Randomizer" FontWeight="SemiBold"
                               VerticalAlignment="Center" FontSize="15"/>
                    <Button HorizontalAlignment="Right" Width="30" Height="29"
                            Content="×" Padding="0" BorderThickness="0" Background="Transparent"
                            FontSize="20" Click="Cancel_Click" ToolTip="Cerrar"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="23,24,23,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="33" Height="33" CornerRadius="9" Background="#375472"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock x:Name="SymbolLabel" Text="!" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D4E9FF"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="MessageLabel" FontSize="14" TextWrapping="Wrap"
                               LineHeight="21" Foreground="#EFF3F8"/>
                    <TextBlock x:Name="DetailsLabel" Margin="0,13,0,0" FontSize="12"
                               Foreground="#A8BED3" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#37465A" BorderThickness="0,1,0,0" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancelar" MinWidth="107"
                            Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="ConfirmButton" Content="Continuar" MinWidth="115"
                            Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>