{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joanjuz/Definitive-Randomizer/blob/main/docs/contracts/definitive-game-data-v1.schema.json",
  "title": "PokeJuz Definitive Game Data v1",
  "type": "object",
  "required": ["format", "schemaVersion", "producer", "game", "source", "coverage", "species", "types", "abilities", "moves", "evolutions"],
  "properties": {
    "format": {"const": "PokeJuz.DefinitiveGameData"},
    "schemaVersion": {"const": 1},
    "coverage": {"const": "exported-records"},
    "producer": {"type": "object", "required": ["id", "version"], "properties": {"id": {"const": "DefinitiveRandomizer"}, "version": {"$ref": "#/$defs/label"}}},
    "game": {
      "type": "object", "required": ["id", "generation", "titleId", "revision", "revisionStatus"],
      "properties": {"id": {"enum": ["ultra-sun", "ultra-moon"]}, "generation": {"const": 7}, "titleId": {"enum": ["00040000001B5000", "00040000001B5100"]}, "revision": {"enum": [null, "1.0"]}, "revisionStatus": {"enum": ["known", "unknown"]}},
      "allOf": [
        {"if": {"properties": {"id": {"const": "ultra-sun"}}}, "then": {"properties": {"titleId": {"const": "00040000001B5000"}}}, "else": {"properties": {"titleId": {"const": "00040000001B5100"}}}},
        {"if": {"properties": {"revisionStatus": {"const": "known"}}}, "then": {"properties": {"revision": {"const": "1.0"}}}, "else": {"properties": {"revision": {"type": "null"}}}}
      ]
    },
    "source": {"type": "object", "required": ["kind", "fingerprintAlgorithm", "fingerprint", "scope"], "properties": {
      "kind": {"const": "saved-project"}, "fingerprintAlgorithm": {"const": "SHA-256"}, "fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "scope": {"const": "personal,moves,evolutions,gametext"}
    }},
    "types": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 0, "maximum": 17}, "name": {"$ref": "#/$defs/label"}}}},
    "abilities": {"type": "array", "minItems": 1, "maxItems": 234, "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 0, "maximum": 233}, "name": {"$ref": "#/$defs/label"}}}},
    "species": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {
      "type": "object", "required": ["speciesId", "formId", "personalIndex", "name", "types", "abilities", "baseStats"],
      "properties": {"speciesId": {"$ref": "#/$defs/speciesId"}, "formId": {"$ref": "#/$defs/formId"}, "personalIndex": {"type": "integer", "minimum": 1, "maximum": 4095}, "name": {"$ref": "#/$defs/label"},
        "types": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 17}},
        "abilities": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 233}},
        "baseStats": {"type": "object", "required": ["hp", "attack", "defense", "specialAttack", "specialDefense", "speed"], "properties": {"hp": {"$ref": "#/$defs/byte"}, "attack": {"$ref": "#/$defs/byte"}, "defense": {"$ref": "#/$defs/byte"}, "specialAttack": {"$ref": "#/$defs/byte"}, "specialDefense": {"$ref": "#/$defs/byte"}, "speed": {"$ref": "#/$defs/byte"}}}
      }
    }},
    "moves": {"type": "array", "minItems": 1, "maxItems": 729, "items": {
      "type": "object", "required": ["id", "name", "typeId", "category", "power", "accuracy", "pp", "priority"],
      "properties": {"id": {"type": "integer", "minimum": 0, "maximum": 728}, "name": {"$ref": "#/$defs/label"}, "typeId": {"type": "integer", "minimum": 0, "maximum": 17}, "category": {"type": "integer", "minimum": 0, "maximum": 2}, "power": {"$ref": "#/$defs/byte"}, "accuracy": {"$ref": "#/$defs/byte"}, "pp": {"$ref": "#/$defs/byte"}, "priority": {"type": "integer", "minimum": -8, "maximum": 8}}
    }},
    "evolutions": {"type": "array", "maxItems": 4096, "items": {
      "type": "object", "required": ["speciesId", "formId", "routes"], "properties": {"speciesId": {"$ref": "#/$defs/speciesId"}, "formId": {"$ref": "#/$defs/formId"}, "routes": {
        "type": "array", "maxItems": 8, "items": {"type": "object", "required": ["method", "argument", "targetSpeciesId", "targetFormId", "level"], "properties": {"method": {"type": "integer", "minimum": 1, "maximum": 42}, "argument": {"type": "integer", "minimum": 0, "maximum": 65535}, "targetSpeciesId": {"$ref": "#/$defs/speciesId"}, "targetFormId": {"type": "integer", "minimum": -1, "maximum": 127}, "level": {"type": "integer", "minimum": 0, "maximum": 100}}}
      }}
    }}
  },
  "$defs": {
    "label": {"type": "string", "minLength": 1, "maxLength": 200},
    "speciesId": {"type": "integer", "minimum": 1, "maximum": 807},
    "formId": {"type": "integer", "minimum": 0, "maximum": 31},
    "byte": {"type": "integer", "minimum": 0, "maximum": 255}
  }
}
